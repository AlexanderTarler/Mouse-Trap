[resource]
script = ExtResource("1_item_data")
item_name = "Lore Fragment (Hearth)"
item_description = "A torn scrap of paper, yellowed with age. The ink is smudged but legible."
item_type = 1
note_text = "...the horn-crowned watcher does not tread where the flames dance. It stalks the dark borders where the pine needles turn black. Keep the oil burning, keep the hearth bright. If the room falls to shadow, it will claim what belongs to the wood. It has watched this cabin since my grandfather laid the logs..."
scene_to_spawn = ExtResource("2_note_scene")
