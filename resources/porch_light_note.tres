[resource]
script = ExtResource("1")
item_name = "Scrap of Paper"
item_description = "A crumpled note with electrical scribbles."
item_type = 1
note_text = "The porch light's wiring is completely shot. No matter how many times I flip the switch, it stays on whenever the generator's running. I've given up trying to fix it — just another thing this cabin has broken.

Thinking about it, I'm leaving it on. Nothing comes up onto that porch while it's lit.

— A."
read_thought = "So the porch light stays on as long as the generator runs. Good. I'll keep it fed."
