; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Mouse Trap"
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"
run/disable_stdout.release=true
config/use_custom_user_dir.release=true
config/custom_user_dir_name.release="Mouse Trap"

[audio]

driver/enable_input=true

[autoload]

GameTime="*res://scripts/managers/game_time.gd"
NightManager="*res://scripts/managers/night_manager.gd"
HorrorSoundManager="*res://scripts/managers/horror_sound_manager.gd"
Inventory="*uid://bjx17mr4lkv1w"
JumpscareManager="*uid://br0tle13g7vbi"
RoutineManager="*res://scripts/managers/routine_manager.gd"
EvidenceManager="*res://scripts/managers/evidence_manager.gd"
RoomLightDetector="*uid://lqer7d8tsn72"
EndgameManager="*res://scripts/managers/endgame_manager.gd"
PeekerManager="*res://scripts/peeker/peeker_manager.gd"
MCPRuntime="*uid://d0d44kj7mgnoo"
TutorialManager="*res://scripts/managers/tutorial_manager.gd"
Checkpoint="*res://scripts/managers/checkpoint_manager.gd"
Weather="*res://scripts/managers/weather.gd"
Monologue="*res://scripts/managers/monologue.gd"
NightTwoStory="*res://scripts/managers/night_two_story.gd"
Captions="*res://scripts/managers/captions.gd"
GameReset="*res://scripts/managers/game_reset.gd"
GamepadInput="*res://scripts/managers/gamepad_input.gd"

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/unused_private_class_variable=false
gdscript/warnings/unused_parameter=false
gdscript/warnings/unused_signal=false
gdscript/warnings/shadowed_variable=false
gdscript/warnings/shadowed_variable_base_class=false
gdscript/warnings/shadowed_global_identifier=false
gdscript/warnings/incompatible_ternary=false
gdscript/warnings/int_as_enum_without_cast=false
gdscript/warnings/confusable_local_declaration=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/prism_collider_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

wood=""
WindowMarkers=""
navmesh_source=""
BottomFloorWindows=""
EntityWaypoints=""
ignore_navmesh=""
IndoorBreachWaypoints=""
SecondFloorWindows=""
ClimbWallWaypoints=""
cinematics=""
hud=""
player=""

[gui]

theme/custom_font="res://assets/fonts/CourierPrime-Regular.ttf"

