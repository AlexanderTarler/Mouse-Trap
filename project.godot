; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mouse Trap"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameTime="*res://scripts/game_time.gd"
NightManager="*res://scripts/night_manager.gd"
HorrorSoundManager="*res://scripts/horror_sound_manager.gd"
Inventory="*uid://bjx17mr4lkv1w"
JumpscareManager="*uid://br0tle13g7vbi"
RoutineManager="*res://scripts/routine_manager.gd"
EvidenceManager="*res://scripts/evidence_manager.gd"
RoomLightDetector="*uid://lqer7d8tsn72"
EndgameManager="*res://scripts/managers/endgame_manager.gd"
PeekerManager="*res://scripts/peeker_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[filesystem]

import/blender/enabled=false

[global_group]

wood=""
WindowMarkers=""
navmesh_source=""
BottomFloorWindows=""
UpperFloorWindows=""
EntityWaypoints=""
ignore_navmesh=""
IndoorBreachWaypoints=""

[input]

move_forward={
"deadzone": 0.5,
"events": [{
"keycode": "W",
"type": "key"
}, {
"keycode": "Up",
"type": "key"
}]
}
move_back={
"deadzone": 0.5,
"events": [{
"keycode": "S",
"type": "key"
}, {
"keycode": "Down",
"type": "key"
}]
}
move_left={
"deadzone": 0.5,
"events": [{
"keycode": "A",
"type": "key"
}, {
"keycode": "Left",
"type": "key"
}]
}
move_right={
"deadzone": 0.5,
"events": [{
"keycode": "D",
"type": "key"
}, {
"keycode": "Right",
"type": "key"
}]
}
ui_shift={
"deadzone": 0.5,
"events": [{
"keycode": "Shift",
"type": "key"
}]
}
ui_crouch={
"deadzone": 0.5,
"events": [{
"keycode": "Control",
"type": "key"
}, {
"keycode": "C",
"type": "key"
}]
}
ui_interact={
"deadzone": 0.5,
"events": [{
"keycode": "E",
"type": "key"
}]
}
ui_inventory={
"deadzone": 0.5,
"events": [{
"keycode": "Tab",
"type": "key"
}]
}

[layer_names]

3d_physics/layer_16="RoomAreas"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
