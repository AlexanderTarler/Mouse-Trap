[layer_names]

3d_physics/layer_16="RoomAreas"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=20480

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024.0
anti_aliasing/quality/msaa_3d=0.0
occlusion_culling/use_occlusion_culling=true
environment/volumetric_fog_enabled=false
